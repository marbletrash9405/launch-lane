{
  // Cloud dev machine for Launch Lane (GitHub Codespaces, or VS Code "Reopen in Container").
  // GitHub → launch-lane → Code → Codespaces → Create codespace on main.
  "name": "Launch Lane",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install",
  "postAttachCommand": "echo 'Run: npm run dev   (then open the forwarded port 3000)'",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Launch Lane site", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
