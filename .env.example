# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit .env.

# Neon Postgres (use the pooled "-pooler" connection string)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Clerk (dashboard.clerk.com → your app → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...   # or NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (Vercel integration)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# The one admin account
ADMIN_EMAIL=launchlanecompany@gmail.com

# Website address used in guardian approval links
PUBLIC_APP_URL=http://localhost:5173

# Email (resend.com). Without a key, emails are only saved to the admin email log.
RESEND_API_KEY=
NOTIFY_FROM=Launch Lane <notifications@launch-laneco.com>
# NOTIFY_EMAIL=contact@launch-laneco.com

# Photos (Vercel Blob). Without a token, photos are saved in ./.local-uploads
BLOB_READ_WRITE_TOKEN=
